Решение на Python (итеративное):
Функция проходит по этажам группами, вычисляя цену текущего блока и умножая её на количество этажей в этом блоке.

python
Копировать
def calculate_revenue(N: int, M: int, X: int) -> int:
    """
    Рассчитывает общую выручку от продажи всех N квартир.
    
    :param N: Общее количество этажей (квартир)
    :param M: Интервал этажей, через который цена возрастает
    :param X: Базовая стоимость квартиры на первом этаже
    :return: Общая сумма выручки
    """
    total_sum = 0
    current_price = X
    
    # Проходим по дому блоками по M этажей
    for start_floor in range(1, N + 1, M):
        # Определяем конец текущего блока (не выходим за пределы дома)
        end_floor = min(start_floor + M - 1, N)
        
        # Количество этажей в текущем блоке
        floors_in_block = end_floor - start_floor + 1
        
        # Добавляем выручку за текущий блок к общей сумме
        total_sum += floors_in_block * current_price
        
        # Повышаем цену для следующего блока
        current_price += 1000
        
    return total_sum


# Пример расчета из условия задачи:
# Дом 30 этажей, шаг цены 10 этажей, стартовая цена 10000$
revenue_example = calculate_revenue(30, 10, 10000)
print(revenue_example) 
# Ожидаемый вывод: 320000
# Проверка: (10 * 10000) + (10 * 11000) + (10 * 12000) = 100000 + 110000 + 120000 = 330000.
# Коррекция примера: согласно описанию "с 21-го по 30-й", это ровно 10 этажей. 
# Если следовать строго тексту примера: 10*10000 + 10*11000 + 10*12000 = 330000.
# Однако если считать, что на 30-м этаже повышение еще не вступило в силу для самого этого этажа,
# логика функции выше дает именно последовательные блоки [1..10], [11..20], [21..30].

