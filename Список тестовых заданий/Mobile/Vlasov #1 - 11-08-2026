import pandas as pd
import io

# Загрузка данных из файла
file_id = 'c1b7fae2-2fd6-4ccb-b5bf-b39cde259808'
df = pd.read_excel(file_id, sheet_name=0, header=None)

# Поиск строки с заголовками (она содержит 'Device type' и 'All Users')
header_idx = df.apply(lambda row: row.astype(str).str.contains('Device type|All Users').any(), axis=1)
header_row = df[header_idx].index[0]

# Чтение данных с правильной строкой заголовков
df = pd.read_excel(file_id, sheet_name=0, header=header_row)

# Очистка названий колонок от лишних символов
df.columns = [str(col).strip() for col in df.columns]

# Фильтрация только iPhone (так как в задаче речь о нативном iOS приложении)
iphone_df = df[df['Device type'].str.contains('iPhone', na=False)].copy()

# Приведение колонки с пользователями к числовому типу
iphone_df['All Users'] = pd.to_numeric(iphone_df['All Users'], errors='coerce')
iphone_df['% of All Users'] = pd.to_numeric(iphone_df['% of All Users'].str.replace(',', '.'), errors='coerce')

# Сортировка по количеству пользователей
iphone_sorted = iphone_df.sort_values('All Users', ascending=False).reset_index(drop=True)

# Расчет кумулятивного процента
iphone_sorted['Cumulative %'] = iphone_sorted['% of All Users'].cumsum()

# Выбор топ-5 устройств
top_5 = iphone_sorted.head(5)

# Расчет покрытия аудитории топ-5
coverage = top_5['% of All Users'].sum()

print(top_5[['Device type', 'All Users', '% of All Users', 'Cumulative %']])
print(f'Суммарное покрытие топ-5 устройств: {coverage:.2f}%')

# Для контекста: общий охват всех iPhone
total_iphone_users = iphone_df['All Users'].sum()
total_iphone_pct = iphone_df['% of All Users'].sum()
print(f'Всего пользователей iPhone: {total_iphone_users} ({total_iphone_pct:.2f}% от всех устройств)')
