Задача 1. Поиск должников по профсоюзным взносам за прошлый месяц (Oracle)
WITH last_month_students AS (
  SELECT s.id, s.name, s.surname
  FROM Student s
),
total_payments AS (
  SELECT p.student_id, SUM(p.amount) AS total_paid
  FROM Payment p
  WHERE TRUNC(p.payment_date, 'MONTH') = TRUNC(ADD_MONTHS(SYSDATE, -1), 'MONTH')
  GROUP BY p.student_id
)
SELECT
  ls.id,
  ls.name,
  ls.surname,
  (100 - COALESCE(tp.total_paid, 0)) AS debt_amount
FROM last_month_students ls
LEFT JOIN total_payments tp ON ls.id = tp.student_id
WHERE (100 - COALESCE(tp.total_paid, 0)) > 0
ORDER BY ls.surname, ls.name;

